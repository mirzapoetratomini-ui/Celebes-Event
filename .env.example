# ====================================================================
# Konfigurasi Environment Celebes Event (Node.js & MySQL)
# ====================================================================

# Port server aplikasi (Default: 3000)
PORT=3000

# Mode aplikasi: 'development' atau 'production'
NODE_ENV=development

# URL domain aplikasi (contoh: https://celebesevent.id atau http://localhost:3000)
APP_URL=http://localhost:3000

# --------------------------------------------------------------------
# Konfigurasi Koneksi Database MySQL / MariaDB (Opsional jika lokal)
# *Catatan: Jika dikosongkan, sistem otomatis memakai Local File Storage
# (database/local_data.json) sehingga aplikasi tetap berjalan 100% normal.
# --------------------------------------------------------------------
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=celebes_event_db
MYSQL_USER=root
MYSQL_PASSWORD=

# --------------------------------------------------------------------
# Google Gemini API Key (Opsional untuk fitur asisten AI server-side)
# --------------------------------------------------------------------
GEMINI_API_KEY=